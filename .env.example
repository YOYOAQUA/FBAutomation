# Facebook Page access token (Meta Developers -> your App -> Messenger -> Page tokens)
PAGE_ACCESS_TOKEN=
# Any string you choose - must match what you enter in the Webhook setup on Meta
VERIFY_TOKEN=
# OpenAI API key
OPENAI_API_KEY=

# Optional - App Secret for verifying X-Hub-Signature-256 on incoming webhooks
APP_SECRET=
# Optional - defaults shown
PORT=3000
GRAPH_API_VERSION=v24.0
